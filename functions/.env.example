# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# These configure the admin-SDK scripts (seed, one-off maintenance). The deployed
# Functions themselves use the runtime service account and do not read this file.

# --- Target project (real project runs) ---------------------------------------
# Path to a service-account JSON with access to the target Firebase project.
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccount.safentia-tech.json
# The Firebase project the admin scripts target.
FIREBASE_PROJECT_ID=safentia-tech
# Realtime Database URL for the target project (region-specific).
FIREBASE_DATABASE_URL=https://safentia-tech-default-rtdb.europe-west1.firebasedatabase.app
# Storage bucket for the target project.
FIREBASE_STORAGE_BUCKET=safentia-tech.firebasestorage.app

# --- Local emulator runs ------------------------------------------------------
# Set to "true" to point the seed/admin scripts at local emulators instead of a
# real project. When true the credentials above are ignored.
USE_EMULATOR=false
DATABASE_EMULATOR_HOST=127.0.0.1:9000
STORAGE_EMULATOR_HOST=127.0.0.1:9199
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# The verified Resend sender. Set once the sending domain is VERIFIED in
# Resend (Domains); until then leave unset - the sandbox default only
# delivers to the Resend account owner.
# EMAIL_FROM_ADDRESS="Safentia <noreply@safentia.co.uk>"

# Testing window only: route EVERY self-serve signup into Stripe TEST mode
# regardless of per-account claims (existing orgs unaffected). REMOVE before
# real customers can sign up.
# FIRERITE_FORCE_TEST_SIGNUPS=true
