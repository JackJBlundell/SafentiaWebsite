rules_version = '2';

// ============================================================================
// Safentia Storage rules (brief 4.3 / 4.4 / 4.8, stories 1011 / 1076).
//
// The object layout mirrors RTDB tenancy AND the environment root, exactly as the
// paths module builds it: {env}/orgs/{orgId}/buildings/{buildingId}/... and
// {env}/orgs/{orgId}/reports/{reportId}.pdf. Three boundaries are enforced, each
// proven in the rules matrix:
//   1. ENVIRONMENT - a testMode user touches only the test/ prefix, a live user
//      only live/; both cross-environment directions denied (brief 4.8).
//   2. ORG ISOLATION - the {orgId} segment must equal the caller's orgId claim,
//      so cross-org reads and writes are impossible (story 1011).
//   3. CONTENT + SIZE - images must be image/* and <= 10MB, documents (any type)
//      <= 25MB, validated at the rules layer so an oversized or wrong-type upload
//      is rejected before it lands (story 1011 AC).
//
// Storage rules cannot read RTDB, so membership is asserted from the custom claim
// (orgId + testMode) that onMembershipChange maintains - the same trusted signal
// the database rules use. App Check is enforced at the bucket level (brief 4.6).
// ============================================================================

service firebase.storage {
  match /b/{bucket}/o {

    // Helper: the caller is signed in and the {env} prefix matches their testMode
    // claim (the test/live boundary). A live user has testMode absent/false and
    // may only enter the live/ tree; a test user only test/. App Check is enforced
    // for Storage at the bucket configuration level (brief 4.6), not asserted via
    // request.app here - the same separation RTDB uses, where attestation is a
    // platform setting rather than a rule expression.
    function envMatches(env) {
      // 'in' guard first: unlike RTDB rules, Storage rules ERROR (deny) when
      // reading an absent token property, and live tokens never carry testMode
      // (lib/claims sets it only as a literal true). Without the guard every
      // live user is denied all Storage access - emulator-proven, 2026-07-14.
      return request.auth != null
        && (env == 'test') == (('testMode' in request.auth.token)
          && request.auth.token.testMode == true);
    }

    // Helper: the {orgId} segment is the caller's own org (tenant isolation).
    // Same 'in' guard as envMatches, for the same reason: a PORTAL token carries
    // no orgId claim at all, and an unguarded read of an absent property ERRORS.
    // The error happens to be contained inside an `||` (emulator-proven, so the
    // portal arm of the actionEvidence read still evaluates), but relying on
    // that is relying on an undocumented evaluator detail - returning a plain
    // false is the same answer by construction. Behaviour is unchanged either
    // way: every use of ownOrg is either standalone (error and false both deny)
    // or the left arm of an OR (both fall through to the right arm).
    function ownOrg(orgId) {
      return 'orgId' in request.auth.token
        && request.auth.token.orgId == orgId;
    }

    // Helper: an image upload within the 10MB ceiling.
    function validImage() {
      return request.resource.contentType.matches('image/.*')
        && request.resource.size <= 10 * 1024 * 1024;
    }

    // Helper: a document upload within the 25MB ceiling (any content type, since
    // documents legitimately span PDFs, office files, images of certificates).
    function validDocument() {
      return request.resource.size <= 25 * 1024 * 1024;
    }

    // Helper: a floor plan file - an image (<=10MB) OR a PDF (<=25MB). Lets an
    // assessor upload a PDF plan while keeping the image ceiling for photos.
    function validFloorPlanFile() {
      return validImage()
        || (request.resource.contentType == 'application/pdf'
          && request.resource.size <= 25 * 1024 * 1024);
    }

    // --- Building media: photos, floor plans, flag composites (images) --------
    // Read: any member of the owning org, in the matching environment.
    // Write: same scope, and the object must be a valid image within 10MB.
    match /{env}/orgs/{orgId}/buildings/{buildingId}/photos/{photoId} {
      allow read: if envMatches(env) && ownOrg(orgId);
      allow write: if envMatches(env) && ownOrg(orgId) && validImage();
    }
    match /{env}/orgs/{orgId}/buildings/{buildingId}/floorPlans/{planId} {
      allow read: if envMatches(env) && ownOrg(orgId);
      allow write: if envMatches(env) && ownOrg(orgId) && validFloorPlanFile();
    }
    match /{env}/orgs/{orgId}/buildings/{buildingId}/flags/{flagId} {
      allow read: if envMatches(env) && ownOrg(orgId);
      allow write: if envMatches(env) && ownOrg(orgId) && validImage();
    }

    // --- Documents (grouped by category) - up to 25MB, any type ---------------
    match /{env}/orgs/{orgId}/buildings/{buildingId}/documents/{category}/{docId} {
      allow read: if envMatches(env) && ownOrg(orgId);
      allow write: if envMatches(env) && ownOrg(orgId) && validDocument();
    }

    // --- Action sign-off evidence (photo or PDF proving the work was done) ----
    // Read: the owning org's staff, AND the owning customer's portal users - the
    // proof is only useful if the customer who has to rely on it can open it.
    // The per-object scope is the customerId in custom metadata, exactly as the
    // report rule below does it, and manageAction STAMPS that metadata itself
    // from the buildingCustomerIndex - never from the uploading client - so an
    // object can only ever be released to the customer that actually owns the
    // building. Absent metadata denies (a rules read of a missing property
    // fails), which is the right way round for evidence.
    //
    // Write: admin only, and only the org's own staff. Evidence closes an action
    // in the legal record, and a Storage write covers replace-in-place, so a
    // member-wide grant would let any account swap the proof after sign-off.
    match /{env}/orgs/{orgId}/buildings/{buildingId}/actionEvidence/{evidenceId} {
      allow read: if envMatches(env)
        && (ownOrg(orgId)
          || (request.auth.token.portalOrgId == orgId
            && resource.metadata.customerId == request.auth.token.customerId));
      allow write: if envMatches(env) && ownOrg(orgId)
        && request.auth.token.roles.admin == true
        && validDocument();
    }

    // --- Organisation assets ---------------------------------------------------
    // Organisation-level assets: the whitelabel logo, the report cover image and
    // customer logos/photos. Image-bounded like photos; written by admins from
    // the settings and customer screens (role enforcement lives in the callables
    // that record the URL - rules here hold the tenant, env and content
    // boundaries). One flat prefix is right for all of them: they are the same
    // kind of object under the same admin-only, image-only ceiling, so a
    // per-purpose prefix would add matches without adding a boundary.
    //
    // This match stays IMAGE-ONLY. Template certificates are PDFs and live one
    // segment deeper (assets/certificates/{id}, below) precisely so this ceiling
    // does not have to be widened: updateOrgProfile validates logoUrl for tenancy
    // but not for content type, so admitting PDFs here would let a PDF be set as
    // the org logo, and the report header would then silently render no logo.
    match /{env}/orgs/{orgId}/assets/{assetId} {
      allow read: if envMatches(env) && ownOrg(orgId);
      // Admin-only: the logo renders on branded reports sent to clients, and a
      // Storage write covers replace-in-place and delete, so member-wide write
      // would let any account deface the mark the callable validated. The admin
      // role rides in the custom claims, the one signal Storage rules can read.
      allow write: if envMatches(env) && ownOrg(orgId)
        && request.auth.token.roles.admin == true
        && validImage();
    }

    // Template certificates: a PDF (<=25MB) merged verbatim into every report the
    // owning template renders. Same admin-only, same tenant and env boundaries as
    // the logo above; the content type is pinned to PDF because that is the only
    // thing report/certificate.ts can splice. The 25MB ceiling matches the
    // MAX_CERTIFICATE_BYTES the merge refuses to exceed.
    match /{env}/orgs/{orgId}/assets/certificates/{certificateId} {
      allow read: if envMatches(env) && ownOrg(orgId);
      allow write: if envMatches(env) && ownOrg(orgId)
        && request.auth.token.roles.admin == true
        && request.resource.contentType == 'application/pdf'
        && request.resource.size <= 25 * 1024 * 1024;
    }

    // --- Generated report PDFs (story 1076) -----------------------------------
    // Written by the report generator via the admin SDK, which bypasses these
    // rules, so client writes are denied outright.
    match /{env}/orgs/{orgId}/reports/{reportFile} {
      // STAFF ONLY. A portal token gets NOTHING here - a customer reads their
      // report through the getReportDownloadUrl callable, which re-derives the
      // building's owning customer, the reader's live /customerMembers standing
      // and their acceptance on every request and answers with a 15-minute
      // signed URL.
      //
      // Why the portal branch was removed: it matched a customerId stamped into
      // the object's custom metadata when the report was generated. Storage
      // rules cannot read RTDB (Firestore only), so that stamp was the only
      // per-object scope available - and it is authorisation FROZEN AT WRITE
      // TIME. It does not follow a building that changes hands, a portal seat
      // that is locked, or a customer that is archived; and a report generated
      // while the building->customer index was missing was stamped empty and
      // became permanently unopenable. The generator still writes the stamp as
      // defence in depth, but nothing grants on it any more - do not restore
      // this branch to "fix" a portal download, fix the callable.
      //
      // Staff direct read STAYS. It is scoped by the orgId claim, which is live
      // (onMembershipChange re-mints it and trips the refresh marker the moment
      // membership changes), so it carries none of the staleness above; and the
      // console and the assessor app resolve report PDFs through the Storage SDK
      // in several places. There is no portal exposure in keeping it: a portal
      // token has no orgId claim, so ownOrg can never be true for one.
      allow read: if envMatches(env) && ownOrg(orgId);
      allow write: if false;
    }

    // --- Nightly RTDB backups (exportBackups) ---------------------------------
    // Written by the scheduled exportBackups Function via the Admin SDK (which
    // bypasses these rules). NO client - staff, portal, operator - may read or
    // write a backup: it is whole-database PII and belongs to the Admin SDK and
    // the Cloud console alone. Stated explicitly (not left to the default deny)
    // so the boundary survives any future broadening of the matches above.
    match /backups/{allPaths=**} {
      allow read, write: if false;
    }

    // --- Default deny ---------------------------------------------------------
    // Anything not matched above is denied. A fire-safety product fails closed.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
