{
  "name": "functions",
  "description": "Safentia Cloud Functions (Phase 1) - the platform's server logic.",
  "version": "0.1.0",
  "private": true,
  "main": "lib/src/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "lint": "eslint --ext .ts src",
    "typecheck": "tsc --noEmit",
    "serve": "npm run build && firebase emulators:start --only functions,database,storage,auth",
    "shell": "npm run build && firebase functions:shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "jest --config jest.config.js",
    "test:rules": "jest --config jest.rules.config.js",
    "seed": "ts-node src/seed/index.ts",
    "render:sample": "npm run build && node lib/src/scripts/renderSampleReport.js"
  },
  "dependencies": {
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.1.1",
    "openai": "^4.104.0",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.15.1",
    "stripe": "^22.4.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.14.10",
    "@types/pdfkit": "^0.13.5",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "firebase": "^11.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
