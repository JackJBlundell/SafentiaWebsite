# Build-time configuration (Vite). Committed on purpose: every value here is
# public by design and ships in the bundle regardless (see src/config/env.ts).
# A fork or preview deployment overrides these with real environment variables,
# which take precedence over this file.

# reCAPTCHA v3 site key for Firebase App Check (Firebase console > App Check >
# Apps > Web). Public by design; the secret key never leaves Google.
VITE_RECAPTCHA_V3_SITE_KEY=6LfdRVUtAAAAADVABUh4VLz3qkQHR9qjn0-gtdKl

# Stripe publishable keys for the billing surface (Stripe dashboard >
# Developers > API keys, one per mode). Publishable keys are public by design -
# they can only create client-side tokens, never charge anyone; the secret keys
# live in Cloud Functions secrets. Live serves users on live data, test serves
# users whose testMode claim routes them to the test data root. REPLACE means
# billing shows a not-configured notice rather than crashing.
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_51U155BIqxQDVPa2zZ8kCSLWzcBTkLPp1YWFI4hyuq20nEemYGQGvMDj1CjZnFjSKJzyvyacEd4bUaaBCa5JzNaG100ybWwTezB
VITE_STRIPE_PUBLISHABLE_KEY_TEST=pk_test_51U155BIqxQDVPa2zsobXrbjqR0A7yJCdjxip9tJ4JlrfpEjFziIM3zWXOsTaaak1q43eEXBJ7cTA0yzH0NpRZYZO00TTGcsUDi
