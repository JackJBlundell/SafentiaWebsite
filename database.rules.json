              ".validate": "newData.isString() && newData.val().length <= 64"
            },
            "title": {
              ".validate": "newData.isString() && newData.val().length <= 200"
            },
            "body": {
              ".validate": "newData.isString() && newData.val().length <= 10000"
            },
            "updatedAt": {
              ".validate": "newData.isNumber()"
            },
            "subject": {
              ".validate": "newData.isString() && newData.val().length <= 200"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      },
      "buildingCustomerIndex": {
        "$orgId": {
          ".read": "auth != null && auth.token.orgId === $orgId && ((auth.token.testMode === true) === ($env === 'test')) && root.child($env).child('orgMembers').child($orgId).child(auth.uid).child('status').val() === 'active'",
          ".write": false,
          "$buildingId": {
            ".read": "auth != null && auth.token.portalOrgId === $orgId && ((auth.token.testMode === true) === ($env === 'test')) && root.child($env).child('buildingCustomerIndex').child($orgId).child($buildingId).val() === auth.token.customerId && root.child($env).child('customers').child($orgId).child(auth.token.customerId).child('status').val() !== 'archived'"
          }
        }
      },
      "emailLog": {
        "$orgId": {
          ".read": "auth != null && auth.token.orgId === $orgId && ((auth.token.testMode === true) === ($env === 'test')) && root.child($env).child('orgMembers').child($orgId).child(auth.uid).child('roles').child('admin').val() === true && root.child($env).child('orgMembers').child($orgId).child(auth.uid).child('status').val() === 'active'",
          ".write": false,
          ".indexOn": [
            "sentAt"
          ]
        }
      },
      "emailTemplates": {
        "$orgId": {
          ".read": "auth != null && auth.token.orgId === $orgId && ((auth.token.testMode === true) === ($env === 'test')) && root.child($env).child('orgMembers').child($orgId).child(auth.uid).child('roles').child('admin').val() === true && root.child($env).child('orgMembers').child($orgId).child(auth.uid).child('status').val() === 'active'",
          "$templateId": {
            ".write": "auth != null && auth.token.orgId === $orgId && ((auth.token.testMode === true) === ($env === 'test')) && root.child($env).child('orgMembers').child($orgId).child(auth.uid).child('roles').child('admin').val() === true && root.child($env).child('orgMembers').child($orgId).child(auth.uid).child('status').val() === 'active' && (!newData.exists() || (newData.hasChildren(['name','subject','heading','blocks','updatedAt','updatedBy']) && newData.child('name').isString() && newData.child('name').val().length <= 100 && newData.child('subject').isString() && newData.child('subject').val().length <= 200 && (!newData.child('preheader').exists() || (newData.child('preheader').isString() && newData.child('preheader').val().length <= 200)) && newData.child('heading').isString() && newData.child('heading').val().length <= 200 && (!newData.child('footerNote').exists() || (newData.child('footerNote').isString() && newData.child('footerNote').val().length <= 500)) && newData.child('updatedAt').isNumber() && newData.child('updatedBy').isString() && newData.child('blocks').hasChildren() && !newData.child('blocks').child('50').exists()))",
            ".validate": "newData.hasChildren(['name','subject','heading','blocks','updatedAt','updatedBy'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length <= 100"
            },
            "subject": {
              ".validate": "newData.isString() && newData.val().length <= 200"
            },
            "preheader": {
              ".validate": "newData.isString() && newData.val().length <= 200"
            },
            "heading": {
              ".validate": "newData.isString() && newData.val().length <= 200"
            },
            "blocks": {
              "$blockId": {
                ".validate": "newData.hasChildren(['id','type']) && (newData.child('type').val() !== 'paragraph' || newData.child('text').exists()) && (newData.child('type').val() !== 'cta' || newData.child('label').exists()) && (newData.child('type').val() !== 'detail-rows' || newData.child('source').exists())",
                "id": {
                  ".validate": "newData.isString() && newData.val().length <= 64",
                  "$other": {
                    ".validate": false
                  }
                },
                "type": {
                  ".validate": "newData.val() === 'paragraph' || newData.val() === 'detail-rows' || newData.val() === 'cta'",
                  "$other": {
                    ".validate": false
                  }
                },
                "text": {
                  ".validate": "newData.isString() && newData.val().length <= 5000",
                  "$other": {
                    ".validate": false
                  }
                },
                "omitIfEmpty": {
                  ".validate": "newData.isBoolean()",
                  "$other": {
                    ".validate": false
                  }
                },
                "source": {
                  ".validate": "newData.val() === 'custom' || newData.val() === 'kind'",
                  "$other": {
                    ".validate": false
                  }
                },
                "rows": {
                  "$rowId": {
                    ".validate": "newData.hasChildren(['id','label','value'])",
                    "id": {
                      ".validate": "newData.isString() && newData.val().length <= 64",
                      "$other": {
                        ".validate": false
                      }
                    },
                    "label": {
                      ".validate": "newData.isString() && newData.val().length <= 200",
                      "$other": {
                        ".validate": false
                      }
                    },
                    "value": {
                      ".validate": "newData.isString() && newData.val().length <= 1000",
                      "$other": {
                        ".validate": false
                      }
                    },
                    "$other": {
                      ".validate": false,
                      "$z1": {
                        ".validate": false,
                        "$z2": {
                          ".validate": false,
                          "$z3": {
                            ".validate": false
                          }
                        }
                      }
                    }
                  }
                },
                "label": {
                  ".validate": "newData.isString() && newData.val().length <= 200",
                  "$other": {
                    ".validate": false
                  }
                },
                "href": {
                  ".validate": "newData.isString() && newData.val().length <= 2000",
                  "$other": {
                    ".validate": false
                  }
                },
                "useKindLink": {
                  ".validate": "newData.isBoolean()",
                  "$other": {
                    ".validate": false
                  }
                },
                "$other": {
                  ".validate": false,
                  "$z1": {
                    ".validate": false,
                    "$z2": {
                      ".validate": false,
                      "$z3": {
                        ".validate": false
                      }
                    }
                  }
                }
              }
            },
            "footerNote": {
              ".validate": "newData.isString() && newData.val().length <= 500"
            },
            "updatedAt": {
              ".validate": "newData.isNumber()"
            },
            "updatedBy": {
              ".validate": "newData.isString()"
            },
            "$other": {
              ".validate": false,
              "$z1": {
                ".validate": false,
                "$z2": {
                  ".validate": false,
                  "$z3": {
                    ".validate": false
                  }
                }
              }
            }
          }
        }
      },
      "emailSettings": {
        "$orgId": {
          ".read": "auth != null && auth.token.orgId === $orgId && ((auth.token.testMode === true) === ($env === 'test')) && root.child($env).child('orgMembers').child($orgId).child(auth.uid).child('roles').child('admin').val() === true && root.child($env).child('orgMembers').child($orgId).child(auth.uid).child('status').val() === 'active'",
          "kinds": {
            "$kindId": {
              ".write": "auth != null && auth.token.orgId === $orgId && ((auth.token.testMode === true) === ($env === 'test')) && root.child($env).child('orgMembers').child($orgId).child(auth.uid).child('roles').child('admin').val() === true && root.child($env).child('orgMembers').child($orgId).child(auth.uid).child('status').val() === 'active' && (!newData.exists() || ((!newData.child('enabled').exists() || newData.child('enabled').isBoolean()) && ($kindId !== 'invitation' || newData.child('enabled').val() !== false) && (!newData.child('templateId').exists() || (newData.child('templateId').isString() && newData.child('templateId').val().length <= 200 && !newData.child('templateId').val().contains('/') && root.child($env).child('emailTemplates').child($orgId).child(newData.child('templateId').val()).exists())) && (!newData.child('digestTemplateId').exists() || (newData.child('digestTemplateId').isString() && newData.child('digestTemplateId').val().length <= 200 && !newData.child('digestTemplateId').val().contains('/') && root.child($env).child('emailTemplates').child($orgId).child(newData.child('digestTemplateId').val()).exists()))))",
              ".validate": "($kindId !== 'invitation' || newData.child('enabled').val() !== false) && (!newData.child('templateId').exists() || (newData.child('templateId').isString() && root.child($env).child('emailTemplates').child($orgId).child(newData.child('templateId').val()).exists())) && (!newData.child('digestTemplateId').exists() || (newData.child('digestTemplateId').isString() && root.child($env).child('emailTemplates').child($orgId).child(newData.child('digestTemplateId').val()).exists()))",
              "enabled": {
                ".validate": "newData.isBoolean() && ($kindId !== 'invitation' || newData.val() === true)",
                "$other": {
                  ".validate": false
                }
              },
              "templateId": {
                ".validate": "newData.isString() && newData.val().length <= 200 && !newData.val().contains('/') && root.child($env).child('emailTemplates').child($orgId).child(newData.val()).exists()",
                "$other": {
                  ".validate": false
                }
              },
              "digestTemplateId": {
                ".validate": "newData.isString() && newData.val().length <= 200 && !newData.val().contains('/') && root.child($env).child('emailTemplates').child($orgId).child(newData.val()).exists()",
                "$other": {
                  ".validate": false
                }
              },
              "$other": {
                ".validate": false,
                "$z1": {
                  ".validate": false,
                  "$z2": {
                    ".validate": false,
                    "$z3": {
                      ".validate": false
                    }
                  }
                }
              }
            }
          }
        }
      },
      ".read": "auth != null && auth.token.superAdmin === true"
    }
  }
}
